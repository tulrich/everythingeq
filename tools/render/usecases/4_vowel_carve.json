{
  "description": "Use case 4: anti-formant carving on a keys bed, keyed by an external vocal sidechain (Flat weighting, -4 dB).",
  "sampleRate": 48000, "seconds": 4,
  "input": {"generate": "keys"},
  "sidechain": {"generate": "vocal"},
  "params": {
    "groups": [{"input": "ExternalSC", "alpha": 0.0, "thresholdDb": -30, "kneeDb": 10,
                "attackMs": 10, "releaseMs": 120}],
    "bands": [
      {"type": "Vowel", "x": 2.5, "y": 0, "z": 1.0, "weighting": "Flat", "dynGroup": 0, "dynRange": -4}
    ]
  }
}
