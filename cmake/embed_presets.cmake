# Writes OUTPUT (a .cc file) embedding the JSON files in PRESET_DIR as raw
# string literals, in file-name order.  Run with cmake -P.
file(GLOB files "${PRESET_DIR}/*.json")
list(SORT files)
set(body "// Generated by cmake/embed_presets.cmake from presets/factory/.\n")
string(APPEND body "// Do not edit.\n\nnamespace eeq {\n\nextern const char* const kFactoryPresetJson[];\n")
string(APPEND body "extern const int kNumFactoryPresetJson;\n\nconst char* const kFactoryPresetJson[] = {\n")
set(count 0)
foreach(f ${files})
  file(READ "${f}" text)
  string(APPEND body "    R\"eeqpreset(${text})eeqpreset\",\n")
  math(EXPR count "${count} + 1")
endforeach()
string(APPEND body "};\n\nconst int kNumFactoryPresetJson = ${count};\n\n}  // namespace eeq\n")
file(WRITE "${OUTPUT}.tmp" "${body}")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
