+// The host resized the view (e.g. the user dragged the edge of the plug-in
+// window): resize the UI to match.  Our own resizes arrive here too, from
+// PlatformResize(), after the UI has its new size, so they don't recurse.
+- (void) setFrameSize: (NSSize) newSize
+{
+  [super setFrameSize: newSize];
+
+  if (!mGraphics || mGraphics->GetResizerMode() != EUIResizerMode::Size)
+    return;
+
+  const float scale = mGraphics->GetDrawScale();
+  const int w = static_cast<int>(std::round(newSize.width / scale));
+  const int h = static_cast<int>(std::round(newSize.height / scale));
+
+  if (w != mGraphics->Width() || h != mGraphics->Height())
+    mGraphics->Resize(w, h, mGraphics->GetDrawScale(), false);
+}
